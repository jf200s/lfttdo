{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "前端只允许事件、对话框与自定义命令；无 shell、无全局文件系统权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-open",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging"
  ]
}
